msgstr "could not pin target {host!r}"

#: src/omega_check/interfaces/tui/app.py:39
msgid "🔍 OMEGA-CHECK"
msgstr "🔍 OMEGA-CHECK"

#: src/omega_check/interfaces/tui/screens/compare.py:32
msgid "COMPARAISON DE SCANS"
msgstr "SCAN COMPARISON"

#: src/omega_check/interfaces/tui/screens/help_screen.py:30
msgid "Saisir une cible (IP ou hostname) et un profil de ports, puis lancer le scan. Chaque port OPEN est ensuite identifié (protocole, logiciel, rôle) automatiquement."
msgstr "Enter a target (IP or hostname) and a port profile, then launch the scan. Each OPEN port is then identified (protocol, software, role) automatically."

#: src/omega_check/interfaces/tui/screens/help_screen.py:38
msgid "Liste tous les scans passés : détail complet, comparaison entre deux scans (marquer une référence puis comparer), ou rejouer un scan sur la même cible."
msgstr "Lists all past scans: full details, comparison between two scans (mark a reference then compare), or replay a scan on the same target."

#: src/omega_check/interfaces/tui/screens/help_screen.py:45
msgid "Depuis le détail d'un scan : JSON (structure complète), texte (rapport compact) ou HTML (rapport visuel, thème d'export indépendant du thème de l'interface)."
msgstr "From a scan's details: JSON (complete structure), text (compact report) or HTML (visual report, export theme independent of the interface theme)."

#: src/omega_check/interfaces/tui/screens/history.py:109
msgid "Impossible de rejouer ce scan (profil inconnu)."
msgstr "Cannot replay this scan (unknown profile)."

#: src/omega_check/interfaces/tui/screens/quit_confirm.py:21
msgid "QUITTER OMEGA-CHECK ?"
msgstr "QUIT OMEGA-CHECK?"

#: src/omega_check/interfaces/tui/screens/scan_setup.py:40
msgid "Profil ou Saisie libre ci-dessous"
msgstr "Profile or free entry below"

#: src/omega_check/interfaces/tui/screens/scan_setup.py:62
#, python-brace-format
msgid "* {host}"
msgstr "* {host}"

#: src/omega_check/interfaces/tui/screens/scan_setup.py:70
msgid "Personnalisé (CUSTOM)"
msgstr "Custom (CUSTOM)"

#: src/omega_check/interfaces/tui/screens/scan_setup.py:87
msgid "ex. 80  /  22,443,8080  /  1000-2000"
msgstr "e.g. 80  /  22,443,8080  /  1000-2000"

#: src/omega_check/interfaces/tui/screens/scan_setup.py:119
msgid "Profil personnalisé : choisissez un de vos profils ou saisissez des ports."
msgstr "Custom profile: choose one of your profiles or enter ports."

#: src/omega_check/interfaces/tui/screens/scan_setup.py:149
msgid "Ce profil est exhaustif (union de tous les profils système) : le scan peut être long. Continuer ?"
msgstr "This profile is exhaustive (union of all system profiles): the scan may take a long time. Continue?"

#: src/omega_check/interfaces/tui/screens/scan_setup.py:189
msgid "Choisissez un profil personnalisé ou saisissez des ports."
msgstr "Choose a custom profile or enter ports."

#: src/omega_check/interfaces/tui/screens/settings_screen.py:82
msgid "Supprimer les cibles"
msgstr "Delete targets"

#: src/omega_check/interfaces/tui/screens/settings_screen.py:138
msgid "SUPPRIMER LES CIBLES ?"
msgstr "DELETE THE TARGETS?"

#: src/omega_check/interfaces/tui/screens/settings_screen.py:139
msgid "Toutes les cibles épinglées seront définitivement supprimées."
msgstr "All pinned targets will be permanently deleted."

#: src/omega_check/interfaces/tui/screens/settings_screen.py:199
msgid "Cibles supprimées."
msgstr "Targets deleted."

#: src/omega_check/interfaces/tui/screens/show_detail.py:38
#, python-brace-format
msgid "Cible : {target} ({target_ip}) — profil {value} — statut {value2}"
msgstr "Target: {target} ({target_ip}) — profile {value} — status {value2}"

#: src/omega_check/interfaces/tui/screens/help_screen.py:52
msgid "Omega-check identifie les services d'une cible unique (scan fixe, pas de dérive vers d'autres IPs) : ports TCP, protocole, logiciel, authentification, WAF, TLS, rôle inféré. Jamais de test actif ni d'authentification tentée."
msgstr "Omega-check identifies the services of a single target (fixed scan, no drift to other IPs): TCP ports, protocol, software, authentication, WAF, TLS, inferred role. Never any active test or authentication attempt."

#: src/omega_check/interfaces/tui/screens/targets.py:44
msgid "Désépingler"
msgstr "Unpin"

