msgstr "contains the omega-check installation"

#: src/omega_check/application/commands/run_scan.py:112
#, python-format
msgid "Scan terminé : %d port(s) analysé(s)."
msgstr "Scan finished: %d port(s) analyzed."

#: src/omega_check/infrastructure/storage/sqlite/scan_repository.py:139
msgid "échec de sauvegarde du host pour le scan {scan_id!r}"
msgstr "could not save the host for scan {scan_id!r}"

#: src/omega_check/infrastructure/storage/sqlite/target_repository.py:26
