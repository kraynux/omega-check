#: src/omega_check/interfaces/tui/app.py:39
msgid "🔍 OMEGA-CHECK"
msgstr "🔍 OMEGA-CHECK"

#: src/omega_check/interfaces/tui/screens/compare.py:32
msgid "COMPARAISON DE SCANS"
msgstr "CONFRONTO DI SCANSIONI"

#: src/omega_check/interfaces/tui/screens/help_screen.py:29
msgid "Saisir une cible (IP ou hostname) et un profil de ports, puis lancer le scan. Chaque port OPEN est ensuite identifié (protocole, logiciel, rôle) automatiquement."
msgstr "Inserire un obiettivo (IP o hostname) e un profilo di porte, quindi avviare la scansione. Ogni porta OPEN viene poi identificata automaticamente (protocollo, software, ruolo)."

#: src/omega_check/interfaces/tui/screens/help_screen.py:37
msgid "Liste tous les scans passés : détail complet, comparaison entre deux scans (marquer une référence puis comparer), ou rejouer un scan sur la même cible."
msgstr "Elenca tutte le scansioni passate: dettaglio completo, confronto tra due scansioni (segnare un riferimento e confrontare) o ripetizione di una scansione sullo stesso obiettivo."

#: src/omega_check/interfaces/tui/screens/help_screen.py:44
msgid "Depuis le détail d'un scan : JSON (structure complète), texte (rapport compact) ou HTML (rapport visuel, thème d'export indépendant du thème de l'interface)."
msgstr "Dal dettaglio di una scansione: JSON (struttura completa), testo (report compatto) o HTML (report visivo, tema di esportazione indipendente dal tema dell'interfaccia)."

#: src/omega_check/interfaces/tui/screens/help_screen.py:51
msgid "Omega-check identifie les services d'une cible unique (scan fixe, pas de dérive vers d'autres IPs) : ports TCP, protocole, logiciel, authentification, WAF, TLS, rôle inféré. Jamais de test actif ni d'authentification tentée."
msgstr "Omega-check identifica i servizi di un singolo obiettivo (scansione fissa, nessuna deriva verso altri IP): porte TCP, protocollo, software, autenticazione, WAF, TLS, ruolo dedotto. Mai test attivi né tentativi di autenticazione."

#: src/omega_check/interfaces/tui/screens/history.py:109
msgid "Impossible de rejouer ce scan (profil inconnu)."
msgstr "Impossibile ripetere questa scansione (profilo sconosciuto)."

#: src/omega_check/interfaces/tui/screens/quit_confirm.py:21
msgid "QUITTER OMEGA-CHECK ?"
msgstr "USCIRE DA OMEGA-CHECK?"

#: src/omega_check/interfaces/tui/screens/scan_setup.py:40
